{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "Establishment/tenant in the multi-tenant SaaS platform.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique restaurant tenant identifier."
        },
        "name": {
          "type": "string",
          "description": "Commercial name of the establishment."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly unique slug (e.g. urbanburguer, pizzariateste)."
        },
        "segment": {
          "type": "string",
          "description": "Type of establishment (Hamburgueria, Pizzaria, etc.)."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone."
        },
        "whatsapp": {
          "type": "string",
          "description": "WhatsApp number with country code for orders."
        },
        "plan": {
          "type": "string",
          "description": "Subscription plan (Básico, Profissional, Premium)."
        },
        "status": {
          "type": "string",
          "description": "Account status (active, inactive)."
        },
        "logoUrl": {
          "type": "string",
          "description": "Establishment logo URL."
        },
        "coverUrl": {
          "type": "string",
          "description": "Cover banner URL."
        },
        "openingTime": {
          "type": "string",
          "description": "Opening time format HH:mm."
        },
        "closingTime": {
          "type": "string",
          "description": "Closing time format HH:mm."
        },
        "statusMode": {
          "type": "string",
          "description": "Status override (auto, open, closed)."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update."
        }
      },
      "required": ["id", "name", "slug", "whatsapp", "status", "plan"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed in the digital menu.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order identifier."
        },
        "restaurantId": {
          "type": "string",
          "description": "Tenant restaurant identifier."
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name."
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number."
        },
        "total": {
          "type": "number",
          "description": "Order total in BRL."
        },
        "status": {
          "type": "string",
          "description": "Current order state (NOVO, CONFIRMADO, EM PREPARO, SAIU PARA ENTREGA, PRONTO PARA RETIRADA, FINALIZADO, CANCELADO)."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "restaurantId", "total", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered customer profile details for automatic lookups.",
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "description": "Clean phone number digits used as the document ID."
        },
        "name": {
          "type": "string",
          "description": "Full name of the customer."
        },
        "cep": {
          "type": "string",
          "description": "Postal code."
        },
        "street": {
          "type": "string",
          "description": "Street address, number, and optional complement."
        },
        "details": {
          "type": "string",
          "description": "Reference point or apartment number."
        },
        "neighborhood": {
          "type": "string",
          "description": "Neighborhood for delivery calculation."
        },
        "cityState": {
          "type": "string",
          "description": "City and State."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of the last update."
        }
      },
      "required": ["phone", "name", "neighborhood"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Customizable product item offered on the menu.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique menu item identifier."
        },
        "restaurantId": {
          "type": "string",
          "description": "Tenant restaurant identifier."
        },
        "name": {
          "type": "string",
          "description": "Name of the item."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the item."
        },
        "price": {
          "type": "number",
          "description": "Selling price in BRL."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL to the item's Unsplash or custom image."
        },
        "category": {
          "type": "string",
          "description": "Category of the item."
        },
        "burgerType": {
          "type": "string",
          "description": "Subcategory or type for burger items."
        },
        "rating": {
          "type": "number",
          "description": "Average user rating out of 5."
        },
        "ratingCount": {
          "type": "string",
          "description": "Number of users who rated this item."
        },
        "isPopular": {
          "type": "boolean",
          "description": "True if the item is labeled as popular."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of the last update."
        }
      },
      "required": ["id", "name", "price", "category"]
    },
    "RestaurantSettings": {
      "title": "RestaurantSettings",
      "description": "Global restaurant settings like logo configurations.",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Custom image URL or compressed base64 of the logo."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of the last update."
        }
      },
      "required": ["url"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Dynamic promotional discount coupons.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier, usually uppercase code."
        },
        "restaurantId": {
          "type": "string",
          "description": "Tenant restaurant identifier."
        },
        "code": {
          "type": "string",
          "description": "Uppercase coupon code."
        },
        "discount": {
          "type": "number",
          "description": "Discount rate or fixed value."
        },
        "type": {
          "type": "string",
          "description": "Type of discount: 'percent' or 'fixed'."
        },
        "description": {
          "type": "string",
          "description": "A description of the coupon's benefits."
        },
        "minOrderValue": {
          "type": "number",
          "description": "Minimum order subtotal to apply this coupon."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of the last update."
        }
      },
      "required": ["id", "code", "discount", "type"]
    },
    "Admin": {
      "title": "Admin",
      "description": "WP Internet platform super administrator.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the super administrator."
        },
        "role": {
          "type": "string",
          "description": "Fixed to 'super_admin'."
        },
        "name": {
          "type": "string",
          "description": "Name or title of the administrator."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["email", "role"]
    },
    "RestaurantAdmin": {
      "title": "RestaurantAdmin",
      "description": "Restaurant-scoped administrator linking user UID to restaurant ID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the restaurant manager."
        },
        "role": {
          "type": "string",
          "description": "Fixed to 'restaurant_admin'."
        },
        "restaurantId": {
          "type": "string",
          "description": "Tenant restaurant ID this user is authorized to manage."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["email", "role", "restaurantId"]
    }
  },
  "firestore": {
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "Super administrator accounts with system-wide privileges."
    },
    "restaurant_admins/{adminId}": {
      "schema": "RestaurantAdmin",
      "description": "Restaurant manager accounts mapped to specific restaurant tenants."
    },
    "restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Tenant establishments."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed at the restaurants."
    },
    "customers/{phone}": {
      "schema": "Customer",
      "description": "Registered customer details indexable by clean phone number."
    },
    "menu_items/{itemId}": {
      "schema": "MenuItem",
      "description": "Dynamic restaurant menu items."
    },
    "settings/{settingId}": {
      "schema": "RestaurantSettings",
      "description": "Global settings for the establishment."
    },
    "coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Dynamic promotional coupons."
    }
  }
}
