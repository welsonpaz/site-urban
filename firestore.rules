rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPER FUNCTIONS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email.lower() == 'welsonpaz@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isUserRestaurantAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/restaurant_admins/$(request.auth.uid));
    }

    function getRestaurantAdminData() {
      return get(/databases/$(database)/documents/restaurant_admins/$(request.auth.uid)).data;
    }

    function isRestaurantAdmin(restId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (isUserRestaurantAdmin() && getRestaurantAdminData().restaurantId == restId)
      );
    }

    function isRestaurantActive(restId) {
      return exists(/databases/$(database)/documents/restaurants/$(restId)) &&
             get(/databases/$(database)/documents/restaurants/$(restId)).data.status == 'active';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // 1. SUPER ADMINS COLLECTION
    // ===============================================================
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      // Allow bootstrap for the verified master account, otherwise only existing Super Admins
      allow create, update: if isSuperAdmin() || (
        isSignedIn() && 
        request.auth.uid == uid && 
        request.auth.token.email.lower() == 'welsonpaz@gmail.com' && 
        request.auth.token.email_verified == true
      );
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }

    // ===============================================================
    // 2. RESTAURANT ADMINS MAPPING
    // ===============================================================
    match /restaurant_admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      // Strictly only Super Admin can assign or edit restaurant admin roles
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 3. MULTI-TENANT RESTAURANTS
    // ===============================================================
    match /restaurants/{restaurantId} {
      // Public read for customer menu browsing and multi-tenant selection
      allow read: if true;

      // Only Super Admin can create new restaurants
      allow create: if isSuperAdmin() && isValidId(restaurantId);

      // Only Super Admin can delete restaurants
      allow delete: if isSuperAdmin() && isValidId(restaurantId);

      // Super Admin can update all fields; Restaurant Admin CANNOT change plan, status, id or createdAt
      allow update: if isSuperAdmin() || (
        isRestaurantAdmin(restaurantId) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['plan', 'status', 'id', 'createdAt'])
      );
    }

    // ===============================================================
    // 4. ORDERS (STRICT MULTI-TENANT ISOLATION)
    // ===============================================================
    match /orders/{orderId} {
      // Customers can place orders only for valid, active restaurants
      // Prevents negative totals, administrative fields, and invalid status
      allow create: if isValidId(orderId) &&
                       incoming().restaurantId is string &&
                       isValidId(incoming().restaurantId) &&
                       isRestaurantActive(incoming().restaurantId) &&
                       incoming().items is list &&
                       incoming().items.size() > 0 &&
                       incoming().total is number &&
                       incoming().total >= 0 &&
                       incoming().subtotal is number &&
                       incoming().subtotal >= 0 &&
                       incoming().discount is number &&
                       incoming().discount >= 0 &&
                       incoming().shipping is number &&
                       incoming().shipping >= 0 &&
                       incoming().total <= (incoming().subtotal + incoming().shipping + 0.05) &&
                       incoming().status in ['NOVO', 'Pendente', 'pendente', 'novo'] &&
                       !('adminNotes' in incoming()) &&
                       !('role' in incoming()) &&
                       !('isVerified' in incoming());

      // Single order lookup: Super Admin or assigned Restaurant Admin
      allow get: if isSuperAdmin() || (
        isSignedIn() &&
        isUserRestaurantAdmin() &&
        resource.data.restaurantId == getRestaurantAdminData().restaurantId
      );

      // List orders: Super Admin can list all orders;
      // Restaurant Admin can ONLY list orders where restaurantId matches their assigned restaurantId
      allow list: if isSuperAdmin() || (
        isSignedIn() &&
        isUserRestaurantAdmin() &&
        resource.data.restaurantId == getRestaurantAdminData().restaurantId
      );

      // Update order: Super Admin or authorized Restaurant Admin (status updates)
      // Cannot alter restaurantId, total, subtotal, or order items
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        isUserRestaurantAdmin() &&
        resource.data.restaurantId == getRestaurantAdminData().restaurantId &&
        !incoming().diff(existing()).affectedKeys().hasAny(['id', 'restaurantId', 'total', 'subtotal', 'items'])
      );

      // Delete orders: Super Admin only
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // 5. MENU ITEMS (SCOPED TO TENANT)
    // ===============================================================
    match /menu_items/{itemId} {
      // Public read for customer menu browsing
      allow read: if true;

      // Creation: Super Admin or authorized Restaurant Admin for incoming restaurantId
      allow create: if isSuperAdmin() || (
        incoming().restaurantId is string && 
        isRestaurantAdmin(incoming().restaurantId) &&
        incoming().price is number &&
        incoming().price >= 0
      );

      // Update: Super Admin or Restaurant Admin (cannot transfer item to another restaurant)
      allow update: if isSuperAdmin() || (
        isRestaurantAdmin(existing().restaurantId) && 
        incoming().restaurantId == existing().restaurantId &&
        incoming().price is number &&
        incoming().price >= 0
      );

      // Deletion: Super Admin or Restaurant Admin of that restaurant
      allow delete: if isSuperAdmin() || isRestaurantAdmin(existing().restaurantId);
    }

    // ===============================================================
    // 6. ADDITIONALS (SCOPED TO TENANT)
    // ===============================================================
    match /additionals/{addId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        incoming().restaurantId is string && 
        isRestaurantAdmin(incoming().restaurantId) &&
        incoming().price is number &&
        incoming().price >= 0
      );
      allow update: if isSuperAdmin() || (
        isRestaurantAdmin(existing().restaurantId) && 
        incoming().restaurantId == existing().restaurantId &&
        incoming().price is number &&
        incoming().price >= 0
      );
      allow delete: if isSuperAdmin() || isRestaurantAdmin(existing().restaurantId);
    }

    // ===============================================================
    // 7. CUSTOMERS (PII PROTECTED & ISOLATED)
    // ===============================================================
    match /customers/{phone} {
      // Read single customer: Super Admin, owning user, or restaurant admin of customer's restaurant
      allow get: if isSuperAdmin() || 
                    (isSignedIn() && (
                      resource.data.ownerUid == request.auth.uid ||
                      (isUserRestaurantAdmin() && resource.data.restaurantId == getRestaurantAdminData().restaurantId)
                    ));

      // Listing customers: Super Admin can list all; Restaurant Admin can only query their own restaurant's customers
      allow list: if isSuperAdmin() || (
        isSignedIn() &&
        isUserRestaurantAdmin() &&
        resource.data.restaurantId == getRestaurantAdminData().restaurantId
      );

      // Creation: phone matches document ID, valid fields
      allow create: if incoming().phone == phone &&
                       incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
                       incoming().street is string && incoming().street.size() > 0 &&
                       incoming().neighborhood is string && incoming().neighborhood.size() > 0;

      // Update: Super Admin, or original owner via matching ownerUid or clientToken
      allow update: if isSuperAdmin() || (
        incoming().phone == existing().phone &&
        (
          (isSignedIn() && existing().ownerUid == request.auth.uid) ||
          (existing().clientToken is string && incoming().clientToken == existing().clientToken) ||
          (!('clientToken' in existing()) && !('ownerUid' in existing()))
        )
      );

      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // 8. SETTINGS (PUBLIC BRANDING VS PRIVATE CONFIG)
    // ===============================================================
    match /settings/{settingId} {
      // Only public settings necessary for menu and branding display are publicly readable
      allow get: if settingId in ['branding', 'public_info', 'theme'] || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 9. COUPONS
    // ===============================================================
    match /coupons/{couponId} {
      allow read: if true;

      allow create: if isSuperAdmin() || (
        incoming().restaurantId is string &&
        isRestaurantAdmin(incoming().restaurantId) &&
        incoming().code is string &&
        incoming().code.size() > 0 &&
        incoming().discount is number &&
        incoming().discount >= 0 &&
        incoming().type in ['percent', 'fixed']
      );

      allow update: if isSuperAdmin() || (
        isRestaurantAdmin(existing().restaurantId) &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().discount is number &&
        incoming().discount >= 0 &&
        incoming().type in ['percent', 'fixed']
      );

      allow delete: if isSuperAdmin() || isRestaurantAdmin(existing().restaurantId);
    }

    // ===============================================================
    // 10. COUPONS METADATA
    // ===============================================================
    match /coupons_meta/{metaId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
